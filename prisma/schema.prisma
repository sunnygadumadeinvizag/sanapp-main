generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// IIPE Central Application Management — sanapp_main_db
// Owns: which users may access which applications (Level 1 access).
// Knows nothing about roles/permissions inside the applications.
// ------------------------------------------------------------------

model Application {
  id           String           @id @default(uuid())
  clientId     String           @unique // matches the OIDC client id registered in the SSO
  name         String
  description  String?
  url          String
  // Grouping used by the My Apps launcher (e.g. Finance, ESTB, Admin, Academic).
  category     String           @default("General")
  enabled      Boolean          @default(true)
  // How the app should be opened from launchers/menus: new tab vs same tab.
  openInNewTab Boolean          @default(true)
  createdAt    DateTime         @default(now())
  grants       UserApplication[]
  issues       TechnicalIssue[]
}

// Technical issues raised by portal users against a specific application
// (e.g. "Login broken", "Report export fails"). Tracked centrally in the
// intranet portal; the Super Admin works them from the Admin Console.
model TechnicalIssue {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Identity from the central SSO session at raise time.
  userId        String?
  username      String
  name          String
  title         String
  description   String
  status        IssueStatus @default(OPEN)
  priority      IssuePriority @default(MEDIUM)
  // Optional resolution note / reply from the Super Admin.
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId, status])
  @@index([username, createdAt])
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// A grant = "this user may open this application".
// userId comes from the SSO user registry; username is denormalized for display.
model UserApplication {
  id            String      @id @default(uuid())
  userId        String? // SSO user id (null until known — e.g. during seed)
  username      String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  grantedAt     DateTime    @default(now())

  @@unique([userId, applicationId])
}
