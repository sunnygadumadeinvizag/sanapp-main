generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------
// IIPE Central Application Management — sanapp_main_db
// Owns: which users may access which applications (Level 1 access).
// Knows nothing about roles/permissions inside the applications.
// ------------------------------------------------------------------

model Application {
  id           String           @id @default(uuid())
  clientId     String           @unique // matches the OIDC client id registered in the SSO
  name         String
  description  String?
  url          String
  // Grouping used by the My Apps launcher (e.g. Finance, ESTB, Admin, Academic).
  category     String           @default("General")
  enabled      Boolean          @default(true)
  // How the app should be opened from launchers/menus: new tab vs same tab.
  openInNewTab Boolean          @default(true)
  createdAt    DateTime         @default(now())
  grants       UserApplication[]
  roleGrants   RoleApplication[]
  issues       TechnicalIssue[]
  notifications AppNotification[]
}

// Technical issues raised by portal users against a specific application
// (e.g. "Login broken", "Report export fails"). Tracked centrally in the
// intranet portal; the Super Admin works them from the Admin Console.
model TechnicalIssue {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  // Identity from the central SSO session at raise time.
  userId        String?
  username      String
  name          String
  title         String
  description   String
  status        IssueStatus @default(OPEN)
  priority      IssuePriority @default(MEDIUM)
  // Optional resolution note / reply from the Super Admin.
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId, status])
  @@index([username, createdAt])
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// A direct per-user decision for one application: ALLOW (grant) or DENY
// (explicit block). A direct row is an *override*: it beats the user's role
// rule unless that role rule is marked `overrideUsers`.
// userId comes from the SSO user registry; username is denormalized for display.
model UserApplication {
  id            String      @id @default(uuid())
  userId        String? // SSO user id (null until known — e.g. during seed)
  username      String
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  role          String      @default("USER") // USER | APP_ADMIN
  effect        String      @default("ALLOW") // ALLOW | DENY
  grantedAt     DateTime    @default(now())

  @@unique([userId, applicationId])
}

// A role rule = "everyone whose primary role is this gets this decision on
// this application", resolved at sign-in time rather than copied per user.
// Adding a user to a role therefore applies the rule automatically, with no
// backfill.
//
// Precedence (see src/lib/access.ts):
//   - `overrideUsers = true`  -> the role rule wins over any direct user row
//                                (role over user).
//   - `overrideUsers = false` -> a direct user row wins when present
//                                (user over role); otherwise this rule applies.
model RoleApplication {
  id            String      @id @default(uuid())
  primaryRole   String // STAFF_TEACHING | STAFF_NON_TEACHING | STUDENT | SCHOLAR | GUEST
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  role          String      @default("USER") // USER | APP_ADMIN
  effect        String      @default("ALLOW") // ALLOW | DENY
  overrideUsers Boolean     @default(false)
  grantedAt     DateTime    @default(now())

  @@unique([primaryRole, applicationId])
}

// ------------------------------------------------------------------
// Central notifications — pushed by every application to Main.
// The header bell in every app shows these grouped by application;
// each app's "App Notifications" page shows only its own.
// ------------------------------------------------------------------
model AppNotification {
  id          String      @id @default(uuid())
  // The application that pushed this notification (Application.clientId).
  appClientId String
  application Application @relation(fields: [appClientId], references: [clientId], onDelete: Cascade)
  // Recipient: SSO username (matches the user registry / session identity).
  username    String
  title       String
  body        String?
  // Deep link into the pushing app (absolute URL, opens from anywhere).
  href        String?
  read        Boolean     @default(false)
  readAt      DateTime?
  createdAt   DateTime    @default(now())

  @@index([username, read, createdAt])
  @@index([appClientId, username, read])
}
