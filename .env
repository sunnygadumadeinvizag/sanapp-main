# IIPE Main — local development environment
DATABASE_URL="postgresql://main_user:main_dev_password@localhost:5432/sanapp_main_db"

# Public URLs
SSO_BASE_URL="http://localhost:3000/sso"
MAIN_BASE_URL="http://localhost:3001/main"
NEXT_PUBLIC_SSO_BASE_URL="http://localhost:3000/sso"
NEXT_PUBLIC_MAIN_BASE_URL="http://localhost:3001/main"

# OIDC client registration (must match the SSO seed)
MAIN_CLIENT_ID="sanapp-main"
MAIN_CLIENT_SECRET="main_dev_client_secret"

# Secret for Main's own session cookie (HS256)
MAIN_SESSION_SECRET="main_session_dev_secret_9b2d41f7"

# Shared key to call the SSO admin API (must match SSO's SSO_ADMIN_KEY)
SSO_ADMIN_KEY="sanapp_admin_dev_key_a1b2c3"

# Shared key that independent applications present when asking Main
# "is this user allowed to access this application?"
MAIN_API_KEY="sanapp_main_api_dev_key_5e8c"
COOKIE_SECURE="false"
BASE_PATH="/main"
NEXT_PUBLIC_BASE_PATH="/main"
LOGREQUEST_BASE_URL="http://localhost:3006/logrequest"
LOGREQUEST_INTERNAL_KEY="ba93cfe7c62460ec66b755050013c0eb4755cc6fc20b574d"
